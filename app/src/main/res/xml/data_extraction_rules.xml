<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Here <include> takes no requireFlags (it would be ignored, and the API key would go up unencrypted), so
    cloud backup as a whole needs end-to-end encryption: a phone with no screen lock backs up nothing, and Settings
    says so. Only what is listed is backed up. Left out: whirl.db (a cache, fetched again) and shared prefs (the check
    alarm, per boot). docs/plans/settings-backup.md; BackupRulesTest checks these files.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/library.preferences_pb" />
        <include domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/library.preferences_pb" />
        <include domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
