<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 and 8.1 (API 26-27; minSdk is 26). These ignore requireFlags, so the API key (datastore/account) never goes up:
    only what is listed is backed up. Left out: the account file, whirl.db (a cache, fetched again) and shared prefs
    (the check alarm, per boot). Android 9-11 use xml-v28; Android 12+ use data_extraction_rules.xml.
    docs/plans/settings-backup.md; BackupRulesTest checks these files.
-->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="file" path="datastore/library.preferences_pb" />
</full-backup-content>
