<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9 to 11. As xml/backup_rules.xml, plus the API key's file: in the cloud only end-to-end encrypted (a phone
    with a screen lock), and in a phone-to-phone transfer, which sets only its own flag. A rule needs all its flags,
    hence two. Android 12+ use data_extraction_rules.xml.
-->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="file" path="datastore/library.preferences_pb" />
    <include domain="file" path="datastore/account.preferences_pb" requireFlags="clientSideEncryption" />
    <include domain="file" path="datastore/account.preferences_pb" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
